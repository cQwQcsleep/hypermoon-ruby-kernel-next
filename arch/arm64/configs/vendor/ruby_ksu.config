# KernelSU / SUSFS variant
CONFIG_KSU=y
# Boot first: the SUSFS-inline mode was never proven on this tree and the last
# SUSFS-enabled build did not boot, so the ReSukiSU variant stays on the
# manual-hook integration that is verified to boot.  CONFIG_KSU_SUSFS must stay
# off: with the choice active, setting both silently picked manual-hook anyway
# in earlier builds, which left SUSFS half-configured.
# CONFIG_KSU_SUSFS is not set
CONFIG_KSU_MANUAL_HOOK=y
# Use the call sites present in this tree instead of the LSM/input-handler
# integrations (those target newer kernels and need extra security hooks).
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=n
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=n
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=n
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
CONFIG_KSU_FULL_NAME_FORMAT="%KSU_VERSION%"
CONFIG_KSU_DEBUG=n
# CONFIG_FTRACE_SYSCALLS is not set: it was the only config change shared by
# every non-booting build, so keep the proven v1.2.1 configuration until the
# ReSukiSU variant boots again.
CONFIG_KSU_DISABLE_MANAGER=n
CONFIG_KSU_DISABLE_POLICY=n
CONFIG_KPM=n

# system_server needs /proc/config.gz at boot (Debug.isVmapStack aborts
# otherwise). Keep IKCONFIG on like HyperMoon; the KSU/SUSFS lines are
# filtered out of the embedded copy by kernel/Makefile.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# CONFIG_IKHEADERS is not set

# Keep KALLSYMS_ALL enabled: HyperMoon 1.0.2 ships it on and MTK vendor
# components do kallsyms_lookup_name() lookups for data symbols. Symbol
# hiding is done by name filtering in kernel/kallsyms.c instead.

# Keep kernel logs readable by privileged processes only
CONFIG_SECURITY_DMESG_RESTRICT=y

# SUSFS is disabled for now (see above).  These options only exist when
# CONFIG_KSU_SUSFS is enabled; keep them listed so enabling SUSFS later only
# needs the single switch.  SUS_MOUNT stays off because its fake mnt_id
# bookkeeping is what made the HyperMoon tree hang on boot.
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=n
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=n
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
