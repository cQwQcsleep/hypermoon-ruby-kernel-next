# KernelSU / SUSFS variant
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
CONFIG_KSU_FULL_NAME_FORMAT="%KSU_VERSION%"
CONFIG_KSU_DEBUG=n
CONFIG_KSU_DISABLE_MANAGER=n
CONFIG_KSU_DISABLE_POLICY=n
CONFIG_KPM=n

# Do not expose the kernel config (and KSU/SUSFS options) via /proc/config.gz
# CONFIG_IKCONFIG is not set
# CONFIG_IKCONFIG_PROC is not set
# CONFIG_IKHEADERS is not set

# Reduce the symbol surface visible from /proc/kallsyms
# CONFIG_KALLSYMS_ALL is not set

# Keep kernel logs readable by privileged processes only
CONFIG_SECURITY_DMESG_RESTRICT=y

CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=n
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
